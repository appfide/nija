# =============================================================================
# Secrets / credentials: NEVER commit. Also enforced by gitleaks (pre-commit +
# CI), scripts/verify_secrets.sh, and GitHub push rules on the repository.
# =============================================================================
# Environment files (keep the documented template only)
.env
.env.*
!.env.example
*.env
*.envrc
.envrc
# Keys, certificates, signing material
*.jks
*.keystore
*.p12
*.pfx
*.p8
*.pem
*.key
*.crt
*.cer
*.der
*.csr
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
id_rsa*
id_ed25519*
*.ppk
*.gpg
*.asc
*.kdbx
.netrc
.npmrc
.pypirc
# Platform credential/config files
key.properties
**/key.properties
# Written by the release workflow from the Developer ID secrets.
Signing.xcconfig
**/Signing.xcconfig
local.properties
**/local.properties
google-services.json
GoogleService-Info.plist
firebase_options.dart
**/firebase_options.dart
.firebaserc
service-account*.json
*-service-account.json
*.credentials.json
credentials.json
client_secret*.json
# Generic secret buckets
secrets/
**/secrets/
*.secret
*.secrets
*.secrets.*
secrets.*.yaml
secrets.*.yml
# Infra state that may embed secrets
*.tfstate
*.tfstate.*
.terraform/
